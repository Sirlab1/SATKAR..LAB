<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lighthouse Report</title>
<style>
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0e1326; padding: 1rem; }
  img { max-width: 100%; height: auto; border-radius: 12px; }
</style>
</head>
<body>
  <main>
    <h1 style="position:absolute;left:-9999px">Lighthouse report</h1>
    <img src="data:image/png;base64," alt="Lighthouse report: Performance 71, Accessibility 85, Best Practices 96, SEO 90">
  </main>
</body>
</html>
