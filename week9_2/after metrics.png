<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lighthouse Report</title>
<style>
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0e1326; padding: 1rem; }
  main { max-width: 70rem; }
  img { width: 100%; height: auto; display: block; border-radius: 12px; }
</style>
</head>
<body>
  <main>
    <h1 style="position:absolute;left:-9999px">Lighthouse report</h1>
    <img src="data:image/png;base64," alt="Lighthouse metrics after fixes: First Contentful Paint 0.4 s, Largest Contentful Paint 0.4 s, Total Blocking Time 0 ms, Cumulative Layout Shift 0, Speed Index 0.5 s">
  </main>
</body>
</html>
